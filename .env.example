# --- Identity / paths ---
PUID=1000
PGID=1000
TZ=America/New_York
MEDIA_ROOT=/your/custom/media/path
CONFIG_ROOT=/your/custom/config/path

# --- PIA VPN (Gluetun) ---
OPENVPN_USER=p1234567
OPENVPN_PASSWORD=your_pia_password
# Asia-focused PIA regions that support port forwarding. Keep PORT_FORWARD_ONLY=on in compose.
# Do not dump the full PIA region list here — Gluetun only needs the exits you actually use.
SERVER_REGIONS=Algeria,India,China
VPN_PORT_FORWARDING=on

# --- Network / access ---
# Bind address for admin UI ports. Use 0.0.0.0 to expose on all interfaces (LAN + Tailscale),
# or a specific private IP (Tailscale/LAN) to restrict. Jellyfin is NOT bound here — use Cloudflare Tunnel.
BIND_IP=0.0.0.0
# Gluetun firewall allowlist for LAN + Tailscale CGNAT (comma-separated).
# Docker overlay/bridge CIDRs are hardcoded in docker-compose.yml — do not add 10.0.0.0/8 here.
LAN_SUBNET=192.168.2.0/24,100.64.0.0/10

# --- Jellyfin ---
# Public Jellyfin URL (Cloudflare Tunnel hostname on the deploy host)
JELLYFIN_PUBLISHED_SERVER_URL=https://movies.example.org

# --- qBittorrent ---
WEBUI_PORT=8080

# --- Prowlarr ---
PROWLARR_PORT=9696

# Gluetun health probes are set in docker-compose.yml (HEALTH_TARGET_ADDRESSES=1.1.1.1:443,8.8.8.8:443).
# github.com / cloudflare.com defaults are a bad fit for Asia exits (DNS/TLS timeouts mark Gluetun unhealthy
# and leave qBittorrent/Prowlarr/FlareSolverr down).
